# Copy to .env, fill in, then: chmod 600 .env
# Loaded by python-dotenv at startup — unlike job-runner.conf, no secrets in the
# Supervisor config.

ANTHROPIC_API_KEY=sk-ant-...

# Chroma. 8001 because 8000 is trading-agent on this box.
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=cvs

# API bind. 172.17.0.1 is the docker0 bridge: reachable from the n8n container,
# unreachable from the internet, with no dependence on ufw.
# Use 127.0.0.1 for local development.
API_HOST=172.17.0.1
API_PORT=5680
